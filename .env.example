# The portfolio assistant answers questions about Piyush from a fixed set of
# published facts. Set at least one provider key — the endpoint tries them in
# the order listed and the first one to answer wins.
#
#   ANTHROPIC_API_KEY   Claude       paid, but new accounts get credits
#   GROQ_API_KEY        Groq         free tier, no card required
#   GEMINI_API_KEY      Gemini       free tier, no card required
#
# Keys are read on the server only and are never sent to the browser.

ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional model overrides. Groq retires models without warning, so several
# may be named, comma separated — they are tried in order and a retired one is
# skipped. Check each provider's current model list.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GROQ_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
GEMINI_MODEL=gemini-2.5-flash

# Exact origins allowed to call the endpoint. Comma separated, no trailing slash.
PORTFOLIO_ALLOWED_ORIGINS=https://piyushchavan.com,https://www.piyushchavan.com

# Questions allowed per client per minute.
PORTFOLIO_REQUEST_LIMIT=10
